  "scripts": {
    "docs:generate-api": "node tools/docs/generate-api-docs.mjs",
    "docs:check": "node tools/docs/generate-api-docs.mjs && git diff --exit-code apps/docs/src/content/docs"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@babel/core": "^7.25.9",
    "@nx/eslint": "22.4.4",
    "@nx/eslint-plugin": "22.4.4",
    "@nx/js": "22.4.4",
    "@nx/vite": "22.4.4",
    "@nx/vitest": "22.4.4",
    "@rollup/plugin-babel": "^6.0.4",
    "@nx/web": "22.4.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.11",
    "@swc/helpers": "~0.5.18",
    "@types/node": "25.1.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "ajv": "^8.17.1",
    "eslint": "~9.39.2",
    "jiti": "2.6.1",
    "jsdom": "^27.4.0",
    "jsonc-eslint-parser": "^2.4.2",
    "nx": "22.4.4",
    "prettier": "^3.8.1",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "verdaccio": "^6.2.5",
    "vite": "^7.3.1",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
