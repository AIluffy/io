{
  "name": "io-source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "npm exec nx run-many -t lint",
    "lint:affected": "npm exec nx affected -t lint --base=origin/main --head=HEAD",
    "lint:mdx": "markdownlint-cli2 --config .markdownlint.json \"apps/docs/src/content/docs/**/*.{md,mdx}\"",
    "docs:generate-api": "node tools/docs/generate-api-docs.mjs",
    "docs:generate-bench": "node tools/docs/generate-bench-docs.mjs",
    "docs:quality": "node tools/docs/check-doc-quality.mjs",
    "docs:check:reference": "node tools/docs/generate-api-docs.mjs && node tools/docs/check-doc-quality.mjs && git diff --exit-code apps/docs/src/content/docs/api-reference apps/docs/src/content/docs/en/api-reference",
    "docs:check": "node tools/docs/generate-api-docs.mjs && node tools/docs/generate-bench-docs.mjs && node tools/docs/check-doc-quality.mjs && git diff --exit-code apps/docs/src/content/docs"
  },
  "private": true,
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@eslint/js": "^9.39.2",
    "@babel/core": "^7.29.0",
    "@nx/eslint": "22.5.0",
    "@nx/eslint-plugin": "22.5.0",
    "@nx/js": "22.5.0",
    "@nx/vite": "22.5.0",
    "@nx/vitest": "22.5.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@lynx-js/react": "^0.116.2",
    "@lynx-js/types": "^3.6.0",
    "@nx/web": "22.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "25.2.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "ajv": "^8.17.1",
    "eslint": "~9.39.2",
    "jiti": "2.6.1",
    "jsdom": "^28.0.0",
    "jsonc-eslint-parser": "^2.4.2",
    "markdownlint-cli2": "^0.20.0",
    "nx": "22.5.0",
    "prettier": "^3.8.1",
    "tinybench": "^2.6.0",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "verdaccio": "^6.2.8",
    "vite": "^7.3.1",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
