{
  "ci": {
    "collect": {
      "url": [
        "/zh-cn/state-management/comparison/"
      ],
      "staticDistDir": "apps/docs/dist",
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
