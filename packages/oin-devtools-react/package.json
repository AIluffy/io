{
  "name": "@oin/devtools-react",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@oin/devtools": "*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.10",
    "react": "^19.2.4",
    "vite": "^7.3.1"
  },
  "nx": {
    "tags": [
      "scope:oin-devtools-react"
    ],
    "targets": {
      "build-base": {
        "command": "echo 'Running build-base for oin-devtools-react. This can be replaced with arbitrary commands.'",
        "cache": true
      },
      "build": {
        "dependsOn": [
          "build-base"
        ]
      }
    }
  }
}
