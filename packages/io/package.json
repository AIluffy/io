{
  "name": "@iostore/store",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./behavior": {
      "types": "./dist/behavior.d.ts",
      "import": "./dist/behavior.js",
      "default": "./dist/behavior.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "scope:io"
    ],
    "targets": {
      "bench": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest bench --config vite.config.ts",
          "cwd": "packages/io"
        }
      },
      "bench-gc": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --expose-gc scripts/snapshot-gc-report.mjs",
          "cwd": "packages/io"
        }
      },
      "perf-budget": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --expose-gc scripts/check-perf-budget.mjs",
          "cwd": "packages/io"
        }
      },
      "bundle-size": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node scripts/check-bundle-size.mjs",
          "cwd": "packages/io"
        }
      }
    }
  },
  "dependencies": {
    "esbuild": "0.27.3",
    "jiti": "2.6.1",
    "tslib": "^2.8.1",
    "vite": "^7.3.1",
    "vitest": "4.0.18"
  }
}
