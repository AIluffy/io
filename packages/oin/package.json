{
  "name": "@oin/store",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js",
      "default": "./dist/experimental.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.8.1",
    "vite": "^7.3.1",
    "jiti": "2.6.1"
  },
  "nx": {
    "tags": [
      "scope:oin"
    ],
    "targets": {
      "build-base": {
        "command": "echo 'Running build-base for oin. This can be replaced with arbitrary commands.'",
        "cache": true
      },
      "build": {
        "dependsOn": [
          "build-base"
        ]
      },
      "bench": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest bench --config vite.config.ts --include src/**/*.bench.ts",
          "cwd": "packages/oin"
        }
      }
    }
  }
}
