{
  "name": "@iostore/react",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIluffy/oin.git",
    "directory": "packages/io-react"
  },
  "bugs": {
    "url": "https://github.com/AIluffy/oin/issues"
  },
  "homepage": "https://github.com/AIluffy/oin#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.d.ts.map",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "@iostore/store": "*"
  },
  "devDependencies": {
    "@types/react-test-renderer": "^19.1.0",
    "@types/react": "^19.2.10",
    "react": "^19.2.4",
    "react-test-renderer": "^19.2.4",
    "vite": "^7.3.1",
    "@iostore/store": "*"
  },
  "nx": {
    "tags": [
      "scope:io-react"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "packages/io-react",
          "command": "node --input-type=module -e \"import { rmSync } from \\\"node:fs\\\"; rmSync(\\\"dist\\\", { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });\" && tsc --build tsconfig.lib.json"
        },
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ]
      }
    }
  }
}
