{
  "name": "io-vue",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "io-store": "*",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "vue": "^3.5.27"
  },
  "nx": {
    "tags": [
      "scope:io-vue"
    ],
    "targets": {
      "build-base": {
        "command": "echo 'Running build-base for io-vue. This can be replaced with arbitrary commands.'",
        "cache": true
      },
      "build": {
        "dependsOn": [
          "build-base"
        ]
      }
    }
  }
}
